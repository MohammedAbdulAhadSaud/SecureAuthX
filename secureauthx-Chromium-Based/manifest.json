{
  "manifest_version": 3,
  "name": "SecureAuthX",
  "version": "0.2.0",
  "description": "Site-specific password derivation, reuse detection, strength analysis, and automatic page security/privacy analysis (trackers, headers, cookies, permissions, fingerprinting). Runs entirely locally — no servers, no plaintext password storage.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/vendor/browser-polyfill.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["storage", "activeTab", "tabs", "cookies", "scripting", "webRequest", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
